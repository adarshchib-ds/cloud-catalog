# ============================================
# Cloud Catalog - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=cloud-catalog
API_VERSION=v1

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://cloud_catalog_user:cloud_catalog_password@localhost:5432/cloud_catalog?schema=public

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# Google Cloud Platform (GCP) Sync
# ============================================
# Path to a GCP service-account JSON key with roles/compute.viewer.
# Read implicitly by google-auth-library (Application Default Credentials) — not parsed by src/config/env.ts.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# GCP project ID used for machineTypes.aggregatedList / regions.list (Cloud Billing Catalog is not project-scoped).
# Read directly via process.env.GCP_PROJECT_ID inside src/providers/gcp/services/gcp-auth.service.ts.
GCP_PROJECT_ID=your-gcp-project-id
