# ============================================
# Cloud Catalog - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Application
NODE_ENV=development
PORT=8080
APP_NAME=cloud-catalog
API_VERSION=v1

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://cloud_catalog_user:cloud_catalog_password@localhost:5432/cloud_catalog?schema=public

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
