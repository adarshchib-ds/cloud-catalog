# ============================================
# Cloud Catalog - Git Ignore
# ============================================

# Dependencies
node_modules/

# Build output (Generated on CI/CD / Docker, do not commit)
dist/
build/

# Environment files (NEVER commit secrets, keep .env.example)
.env
.env.local
.env.*.local
!.env.example

# GCP service-account credentials (NEVER commit secrets)
gcp-service-account.json
*-service-account.json
*.key.json

# Temporary / Internal Scratch Scripts & Data (DO NOT COMMIT SECRETS)
scripts/seedAndPrice.ts
backup-db.js
prisma/seed-data.json
prisma/backups/

# Logs & Debugging
logs/
*.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite local files
*.db
*.db-journal

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db

# Testing & Coverage
coverage/
.nyc_output/

# Temporary files & cache
.cache/
temp/
tmp/
pnpm-lock.yaml
