{
  "name": "cloud-catalog",
  "version": "1.0.0",
  "description": "Backend API for the Cloud Comparison Platform - Compare cloud services across AWS, Azure, and GCP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed": "ts-node prisma/seed.ts",
    "db:setup": "pnpm run prisma:migrate && pnpm run db:seed",
    "sync:aws": "ts-node -r tsconfig-paths/register scripts/syncAws.ts",
    "sync:azure": "ts-node -r tsconfig-paths/register scripts/syncAzure.ts",
    "sync:gcp": "ts-node -r tsconfig-paths/register scripts/syncGcp.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "cloud",
    "aws",
    "azure",
    "gcp",
    "comparison",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-account": "^3.1108.0",
    "@aws-sdk/client-cost-explorer": "^3.1108.0",
    "@aws-sdk/client-ec2": "^3.1083.0",
    "@aws-sdk/client-organizations": "^3.1110.0",
    "@aws-sdk/client-pricing": "^3.1083.0",
    "@aws-sdk/client-sts": "^3.1108.0",
    "@azure/arm-compute": "^24.1.0",
    "@azure/arm-subscriptions": "^6.0.0",
    "@azure/identity": "^4.13.1",
    "@google-cloud/compute": "^6.13.0",
    "@prisma/client": "^5.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "winston-transport": "^4.9.0"
  }
}
